{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foundry:diagramgen:process-diagram:v1:schema",
  "title": "process-diagram/v1 model",
  "description": "Authoring aid for diagram-json/v1 models with profile process-diagram/v1. Go validation in diagramgen is authoritative: it also enforces unique ids, flow degrees per node kind, reachability, byte lengths and strict JSON decoding, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profileVersion", "id", "title", "lanes", "nodes", "flows"],
  "properties": {
    "formatVersion": {"const": "diagram-json/v1"},
    "profileVersion": {"const": "process-diagram/v1"},
    "id": {"$ref": "#/$defs/identifier"},
    "title": {"$ref": "#/$defs/label"},
    "lanes": {
      "description": "Lane order is the visual order, top to bottom.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "label": {"$ref": "#/$defs/label"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "lane"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "kind": {"enum": ["start", "end", "task", "exclusive", "parallel"]},
          "label": {"$ref": "#/$defs/label"},
          "lane": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "from": {"$ref": "#/$defs/identifier"},
          "to": {"$ref": "#/$defs/identifier"},
          "label": {"$ref": "#/$defs/label"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
    },
    "label": {
      "description": "Plain text, 1 to 120 UTF-8 bytes, not blank (no Unicode white space only), no control characters, U+2028, U+2029, U+FFFE or U+FFFF. maxLength here counts characters, so the byte limit is checked only by Go.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ufffe\\uffff]*[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufffe\\uffff][^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ufffe\\uffff]*$"
    }
  }
}
