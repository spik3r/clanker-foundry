{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry logical architecture diagram model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "profileVersion",
    "id",
    "title",
    "nodes",
    "links"
  ],
  "properties": {
    "formatVersion": {
      "const": "diagram-json/v1"
    },
    "profileVersion": {
      "const": "architecture-diagram/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ufffe\\uffff]*$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ufffe\\uffff]*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "actor",
            "service",
            "store",
            "external"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    }
  }
}
