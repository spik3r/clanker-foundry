    {"id": "Shelf", "name": "Wishlist", "kind": "class", "attributes": [], "operations": []}
  ],
  "relations": [
    {"id": "R1", "kind": "composition", "from": "Order", "to": "Line", "fromLabel": "1", "toLabel": "1..*"},
