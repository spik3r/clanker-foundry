    {"id": "R3", "kind": "realization", "from": "Product", "to": "Priced"},
    {"id": "R4", "kind": "inheritance", "from": "Gift", "to": "Product"},
    {"id": "R5", "kind": "association", "from": "Line", "to": "Product", "label": "refers to", "fromLabel": "*", "toLabel": "1"},
    {"id": "R6", "kind": "directed", "from": "Order", "to": "Status", "label": "status"},
    {"id": "R7", "kind": "aggregation", "from": "Customer", "to": "Order", "fromLabel": "1", "toLabel": "0..*"},
    {"id": "R8", "kind": "aggregation", "from": "Shelf", "to": "Product", "fromLabel": "1", "toLabel": "0..*"},
    {"id": "R9", "kind": "dependency", "from": "Customer", "to": "Shelf", "label": "uses"}
  ]
