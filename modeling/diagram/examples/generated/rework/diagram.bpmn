<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions.DocumentReview" name="Document review with rework" targetNamespace="urn:foundry:diagramgen:process-diagram:v1" exporter="diagramgen" exporterVersion="1.2.2">
  <collaboration id="Collaboration.DocumentReview">
    <participant id="Participant.DocumentReview" name="Document review with rework" processRef="Process.DocumentReview"/>
  </collaboration>
  <process id="Process.DocumentReview" name="Document review with rework" isExecutable="false">
    <laneSet id="LaneSet.DocumentReview">
      <lane id="Author" name="Author">
        <flowNodeRef>Draft</flowNodeRef>
        <flowNodeRef>Dropped</flowNodeRef>
        <flowNodeRef>Revise</flowNodeRef>
        <flowNodeRef>Start</flowNodeRef>
      </lane>
      <lane id="Reviewer" name="Reviewer">
        <flowNodeRef>Approved</flowNodeRef>
        <flowNodeRef>Review</flowNodeRef>
      </lane>
      <lane id="Editor" name="Editor">
        <flowNodeRef>Done</flowNodeRef>
        <flowNodeRef>Escalate</flowNodeRef>
        <flowNodeRef>Publish</flowNodeRef>
      </lane>
    </laneSet>
    <exclusiveGateway id="Approved" name="Approved?">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
      <outgoing>F5</outgoing>
      <outgoing>F6</outgoing>
    </exclusiveGateway>
    <endEvent id="Done" name="Published">
      <incoming>F8</incoming>
    </endEvent>
    <task id="Draft" name="Write draft">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </task>
    <endEvent id="Dropped" name="Abandoned">
      <incoming>F9</incoming>
    </endEvent>
    <task id="Escalate" name="Escalate to editor">
      <incoming>F6</incoming>
      <outgoing>F9</outgoing>
    </task>
    <task id="Publish" name="Publish document">
      <incoming>F4</incoming>
      <outgoing>F8</outgoing>
    </task>
    <task id="Review" name="Check the draft against the style guide and the legal requirements">
      <incoming>F2</incoming>
      <incoming>F7</incoming>
      <outgoing>F3</outgoing>
    </task>
    <task id="Revise" name="Revise draft">
      <incoming>F5</incoming>
      <outgoing>F7</outgoing>
    </task>
    <startEvent id="Start" name="Draft requested">
      <outgoing>F1</outgoing>
    </startEvent>
    <sequenceFlow id="F1" sourceRef="Start" targetRef="Draft"/>
    <sequenceFlow id="F2" sourceRef="Draft" targetRef="Review"/>
    <sequenceFlow id="F3" sourceRef="Review" targetRef="Approved"/>
    <sequenceFlow id="F4" name="yes" sourceRef="Approved" targetRef="Publish"/>
    <sequenceFlow id="F5" name="no" sourceRef="Approved" targetRef="Revise"/>
    <sequenceFlow id="F6" name="stuck" sourceRef="Approved" targetRef="Escalate"/>
    <sequenceFlow id="F7" sourceRef="Revise" targetRef="Review"/>
    <sequenceFlow id="F8" sourceRef="Publish" targetRef="Done"/>
    <sequenceFlow id="F9" sourceRef="Escalate" targetRef="Dropped"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram.DocumentReview">
    <bpmndi:BPMNPlane id="Plane.DocumentReview" bpmnElement="Collaboration.DocumentReview">
      <bpmndi:BPMNShape id="Shape.Participant.DocumentReview" bpmnElement="Participant.DocumentReview" isHorizontal="true">
        <dc:Bounds x="20" y="48" width="1681" height="730"/>
