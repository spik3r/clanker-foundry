      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge.F09" bpmnElement="F09">
        <di:waypoint x="1083" y="136"/>
        <di:waypoint x="1448" y="136"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge.F10" bpmnElement="F10">
        <di:waypoint x="1472" y="160"/>
        <di:waypoint x="1472" y="190"/>
        <di:waypoint x="1568" y="190"/>
        <di:waypoint x="1568" y="312"/>
        <di:waypoint x="1629" y="312"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge.F11" bpmnElement="F11">
        <di:waypoint x="1779" y="312"/>
        <di:waypoint x="1800" y="312"/>
        <di:waypoint x="1800" y="136"/>
        <di:waypoint x="1918" y="136"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
