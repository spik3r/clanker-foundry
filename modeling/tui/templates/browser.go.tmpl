[[[if .Hosted]]]// This browser is hosted: it is one page body inside a host application's
// own page, not a program of its own. The hosting contract:
//
//   - Forward tea.WindowSizeMsg with the size of the body area, not the
//     terminal. Every layout rule applies to that size.
//   - Forward key messages unless the host handles them itself. While
//     CapturesKeys reports true, always forward every key: the browser owns
//     the keyboard, and the host must not treat digits, q or ctrl+c as its own.
//   - Store the Model that Update returns.
//   - Call View for the body. It is exactly the width and height of the last
//     WindowSizeMsg and has no title line, status line or key-hint footer.
//     Draw those in the host, using Title and KeyHints.
//
// The browser never returns tea.Quit. q and ctrl+c are ignored outside help;
// the host owns quitting.
[[[else]]]// This browser is standalone: it owns the terminal, draws its own title and
// key-hint footer and quits on q or ctrl+c. To place one inside an
// application's page, set "embed": "hosted" in the model.
[[[end]]]// The view colours can be set at run time with WithColors.
package [[[.PackageName]]]

import tea "charm.land/bubbletea/v2"

// Model implements tea.Model. Host applications own data fetching and commands.
type Model struct {
 browser browser
 width,height int
 sized bool
 colors Colors
}

// KeyHint is one key and what it does in the current state.
type KeyHint struct{ Key, Action string }

// KeyHints returns the hints the standalone footer shows for the current
// state, widest form, in order[[[if .Hosted]]], except the quit hint: this browser ignores q and
// ctrl+c and the host owns quitting[[[end]]]. A host can draw them in its own footer.
func (m Model) KeyHints() []KeyHint { return keyHints(m.browser.state, m.browser.data) }

// Title returns the model's title for a host to show.
func (m Model) Title() string { return [[[quote .Title]]] }

// CapturesKeys reports whether the browser must receive every key. It is true
// while the help overlay is open: a host must then forward all keys and not
// treat digits, q or ctrl+c as its own.
func (m Model) CapturesKeys() bool { return m.browser.state.helpOpen }

// WithColors returns a model that draws with the given colours. Each nonempty
// value must be #RRGGBB; an empty value keeps the default for that role. On an
// invalid value the error is returned and the model is unchanged. Colours are
// applied to the roles that replace the defaults; they never reach the data.
func (m Model) WithColors(c Colors) (Model, error) {
 if err:=c.validate();err!=nil{return m,err}
 m.colors=c
 return m,nil
}

// New creates a browser with a ready snapshot. Duplicate or empty IDs are rejected.
func New(records []Record) (Model,error) { return (Model{}).Replace(Snapshot{Status:Ready,Records:records}) }

// Replace validates and copies a snapshot. On error the original model is returned.
func (m Model) Replace(next Snapshot) (Model,error) {
 d,err:=recordsData(next);if err!=nil{return m,err}
 b,err:=m.browser.replaceData(d,plan(m.width,m.height));if err!=nil{return m,err}
 m.browser=b;return m,nil
}

// Selected returns the ID of the record shown as selected, or "" when none is:
// the browser is loading, failed or empty.
func (m Model) Selected() string {
 if m.browser.state.selectedIndex(m.browser.data)<0 { return "" }
 return m.browser.state.selectedID
}

// Focus returns the focused pane, "list" or "detail". Loading and failed
// snapshots retain it.
func (m Model) Focus() string {
 if m.browser.state.focus==detailPane { return "detail" }
 return "list"
}

// Layout returns the variant for the current size: "wide", "narrow" or "tiny".
// A model that has not yet received a size is "tiny".
func (m Model) Layout() string {
 switch plan(m.width,m.height).variant {
 case wide: return "wide"
 case narrow: return "narrow"
 }
 return "tiny"
}

// HelpOpen reports whether the help overlay is open.
func (m Model) HelpOpen() bool { return m.browser.state.helpOpen }

// Status returns the status of the current snapshot.
func (m Model) Status() Status { return Status(m.browser.data.status) }

func (m Model) Init() tea.Cmd{return nil}
func (m Model) Update(msg tea.Msg)(tea.Model,tea.Cmd){
 switch msg:=msg.(type){
 case tea.WindowSizeMsg:
  m.width,m.height,m.sized=max(0,msg.Width),max(0,msg.Height),true
  m.browser=m.browser.resize(plan(m.width,m.height))
 case tea.KeyPressMsg:
  return m.handle(actionFor(msg.String()))
 }
 return m,nil
}
func(m Model)handle(a action)(Model,tea.Cmd){
 p:=plan(m.width,m.height)
 if m.browser.state.helpOpen{m.browser=m.browser.update(a,p);return m,nil}
[[[if .Hosted]]] if a==quitAction{return m,nil}
[[[else]]] if a==quitAction{return m,tea.Quit}
[[[end]]] m.browser=m.browser.update(a,p);return m,nil
}
func(m Model)View()tea.View{
 text:="";if m.sized{text=m.browser.render(plan(m.width,m.height),theme{color:true,colors:m.colors.resolved()})}
 v:=tea.NewView(text)
[[[if not .Hosted]]] v.AltScreen=true
[[[end]]] return v
}
