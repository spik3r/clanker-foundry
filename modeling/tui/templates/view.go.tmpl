package [[[.PackageName]]]

import (
	"fmt"
	"image/color"
	"regexp"
	"slices"
	"strings"
	"unicode"

	"charm.land/lipgloss/v2"
	"github.com/charmbracelet/x/ansi"

	"github.com/spik3r/flexgo"
)

type tone int

const (
	normalTone tone = iota
	headingTone
	selectedTone
	mutedTone
)

// Colors sets the view colours at run time with Model.WithColors. Colours are
// application presentation, not part of the model. Each nonempty value is
// #RRGGBB; an empty value keeps the default for that role.
//
//   - Background: the page background behind every row, the padding and fill,
//     the help overlay and the size and status messages. Default #202638. Set
//     it to the host's background so no patch of another colour shows.
//   - Text: the foreground of ordinary rows and messages. Default #d3d9e8.
//   - Muted: the foreground of secondary text, the standalone status line and
//     footer. A hosted browser draws none, so Muted has no visible effect there.
//     Default #9daac3.
//   - Accent: the bold foreground of pane labels, the title line and the help
//     and status headings. Default #a7c5ff.
//   - Border: the background of the one-cell gutter between the two panes of
//     the wide layout. Default is the effective Background, so by default the
//     gutter is invisible; a different value draws a vertical divider.
//   - SelectionText: the foreground of the selected list row. Default #d3d9e8.
//   - SelectionBackground: the background of the selected list row. Default #384f72.
type Colors struct {
	Background, Text, Muted, Accent, Border, SelectionText, SelectionBackground string
}

var hexColor = regexp.MustCompile(`^#[0-9A-Fa-f]{6}$`)

func (c Colors) validate() error {
	for _, role := range []struct{ name, value string }{
		{"Background", c.Background}, {"Text", c.Text}, {"Muted", c.Muted}, {"Accent", c.Accent}, {"Border", c.Border},
		{"SelectionText", c.SelectionText}, {"SelectionBackground", c.SelectionBackground},
	} {
		if role.value != "" && !hexColor.MatchString(role.value) {
			return fmt.Errorf("colour %s must be #RRGGBB, got %q", role.name, role.value)
		}
	}
	return nil
}

// resolved fills empty roles with the defaults.
func (c Colors) resolved() Colors {
	for _, role := range []struct{ value *string; def string }{
		{&c.Background, "#202638"}, {&c.Text, "#d3d9e8"}, {&c.Muted, "#9daac3"}, {&c.Accent, "#a7c5ff"},
		{&c.SelectionText, "#d3d9e8"}, {&c.SelectionBackground, "#384f72"},
	} {
		if *role.value == "" {
			*role.value = role.def
		}
	}
	return c
}

type theme struct {
	color  bool
	colors Colors // resolved, except Border, which is empty unless set
}

func (t theme) background() color.Color {
	if t.color {
		return lipgloss.Color(t.colors.resolved().Background)
	}
	return nil
}

func (t theme) line(text string, width int, kind tone) string {
	if width <= 0 {
		return ""
	}
	// Data is plain text, never terminal commands or caller-owned styling.
	text = strings.ToValidUTF8(text, "�")
	text = strings.Map(func(r rune) rune {
		if unicode.IsControl(r) {
			return ' '
		}
		return r
	}, ansi.Strip(text))
	text = ansi.Truncate(text, width, "…")
	text += strings.Repeat(" ", max(0, width-ansi.StringWidth(text)))
	if !t.color {
		return text
	}
	c := t.colors.resolved()
	style := lipgloss.NewStyle().Background(t.background()).Foreground(lipgloss.Color(c.Text))
	switch kind {
	case headingTone:
		style = style.Bold(true).Foreground(lipgloss.Color(c.Accent))
	case selectedTone:
		style = style.Background(lipgloss.Color(c.SelectionBackground)).Foreground(lipgloss.Color(c.SelectionText)).Bold(true)
	case mutedTone:
		style = style.Foreground(lipgloss.Color(c.Muted))
	}
	return style.Render(text)
}

func (t theme) block(lines []string, width, height int) string {
	if width <= 0 || height <= 0 {
		return ""
	}
	out := make([]string, height)
	for row := range out {
		text := ""
		if row < len(lines) {
			text = lines[row]
		}
		out[row] = t.line(text, width, normalTone)
	}
	return strings.Join(out, "\n")
}

func panel(title string, lines []string, offset, selected int, t theme) *flexgo.Node {
	return &flexgo.Node{
		Flex:       1,
		Background: t.background(),
		View: func(width, height int) string {
			if width <= 0 || height <= 0 {
				return ""
			}
			out := make([]string, height)
			out[0] = t.line(title, width, headingTone)
			for row := 1; row < height; row++ {
				idx := offset + row - 1
				text, kind := "", normalTone
				if idx >= 0 && idx < len(lines) {
					text = lines[idx]
					if idx == selected {
						kind = selectedTone
					}
				}
				out[row] = t.line(text, width, kind)
			}
			return strings.Join(out, "\n")
		},
	}
}

// filterLabel is the tail of the list label: the position among the listed
// records, or, while a filter text is kept or being typed, the number listed
// out of all records and the text.
func filterLabel(s state, total, shown, pos int) string {
	if !filterEnabled || (s.filterText == "" && !s.filterOpen) {
		return fmt.Sprintf(" %d/%d", pos+1, shown)
	}
	label := fmt.Sprintf(" %d/%d /%s", shown, total, s.filterText)
	if s.filterOpen {
		label += "_"
	}
	return label
}

func (b browser) tree(p layout, t theme) *flexgo.Node {
	if p.variant == tiny {
		minimum := fmt.Sprintf("Minimum: %dx%d", minimumWidth, minimumHeight)
[[[if .Hosted]]]		lines := []string{"Resize to continue", minimum}
[[[else]]]		lines := []string{"Resize to continue", minimum, keyFor(helpAction) + " help  " + keyFor(quitAction) + " quit"}
[[[end]]]		if b.state.helpOpen {
			lines = []string{"Help open: " + keyFor(closeAction) + "/" + keyFor(helpAction) + " closes", minimum}
		}
		return &flexgo.Node{View: func(w, h int) string { return t.block(lines, w, h) }, Background: t.background()}
	}

	s := b.state
	var body *flexgo.Node
	idx := s.selectedIndex(b.data)
	switch {
	case s.helpOpen:
		body = panel("[Help]", helpLines(s, b.data), s.helpOffset, -1, t)
	case idx < 0 && b.data.status == ready && len(b.data.items) > 0:
		// Nothing matches the kept filter: only the list is shown.
		body = panel("["+[[[quote .ListLabel]]]+"]"+filterLabel(s, len(b.data.items), 0, -1), []string{"No matches"}, 0, -1, t)
	case idx < 0:
		title, message := "Empty", b.data.message
		switch b.data.status {
		case loading:
			title = "Loading"
			if message == "" {
				message = "Loading records..."
			}
		case failed:
			title = "Error"
			if message == "" {
				message = "Could not load records."
			}
		default:
			if message == "" {
				message = "No records."
			}
		}
		body = panel(title, []string{message}, 0, -1, t)
	default:
		rows := s.rows(b.data)
		labels := make([]string, len(rows))
		pos := slices.Index(rows, idx)
		for i, at := range rows {
			prefix := "  "
			if i == pos {
				prefix = "> "
			}
			labels[i] = prefix + b.data.items[at].label
		}
		listTitle, detailTitle := [[[quote .ListLabel]]], [[[quote .DetailLabel]]]
		if s.focus == listPane {
			listTitle = "[" + listTitle + "]"
		} else {
			detailTitle = "[" + detailTitle + "]"
		}
		listTitle += filterLabel(s, len(b.data.items), len(labels), pos)
		list := panel(listTitle, labels, s.listOffset, pos, t)
		details := panel(detailTitle, detailRows(b.data.items[idx].details, p), s.detailOffset, -1, t)
		if p.variant == wide {
			list.Width = p.listWidth
			if t.color && t.colors.Border != "" {
				// An explicit Border colour draws the gutter as a divider.
				divider := &flexgo.Node{Width: p.gap, Background: lipgloss.Color(t.colors.Border), View: func(w, h int) string {
					if w <= 0 || h <= 0 {
						return ""
					}
					row := lipgloss.NewStyle().Background(lipgloss.Color(t.colors.Border)).Render(strings.Repeat(" ", w))
					return strings.TrimSuffix(strings.Repeat(row+"\n", h), "\n")
				}}
				body = &flexgo.Node{Flex: 1, Dir: flexgo.Row, Background: t.background(), Children: []*flexgo.Node{list, divider, details}}
			} else {
				body = &flexgo.Node{Flex: 1, Dir: flexgo.Row, Gap: p.gap, Background: t.background(), Children: []*flexgo.Node{list, details}}
			}
		} else if s.focus == detailPane {
			body = details
		} else {
			body = list
		}
	}

[[[if .Hosted]]]	return body
}
[[[else]]]	mode, focus := "narrow", [[[quote .ListLabel]]]
	if p.variant == wide {
		mode = "wide"
	}
	if s.focus == detailPane {
		focus = [[[quote .DetailLabel]]]
	}
	if idx < 0 {
		focus = "Status"
	}
	if s.helpOpen {
		focus = "Help"
	}
	line := func(text string, kind tone) *flexgo.Node {
		return &flexgo.Node{
			Height: 1, Background: t.background(),
			View: func(w, h int) string {
				if h <= 0 {
					return ""
				}
				return t.line(text, w, kind)
			},
		}
	}
	return &flexgo.Node{
		Dir: flexgo.Col, Background: t.background(),
		Children: []*flexgo.Node{
			line([[[quote .Title]]], headingTone),
			line(mode+" | focus: "+focus, mutedTone),
			body,
			line(footer(s, b.data, p), mutedTone),
		},
	}
}
[[[end]]]
// hintText joins hints as "key action" separated by single spaces.
func hintText(hints []KeyHint) string {
	parts := make([]string, len(hints))
	for i, h := range hints {
		parts[i] = h.Key + " " + h.Action
	}
	return strings.Join(parts, " ")
}

// keyHints lists the hints of the standalone footer for the current state, in
// order, in their widest form[[[if .Hosted]]]. A hosted browser omits the quit hint[[[end]]].
func keyHints(s state, d data) []KeyHint {
	var hints []KeyHint
	if s.helpOpen {
		return []KeyHint{
			{keyFor(downAction) + "/" + keyFor(upAction), "scroll"},
			{keyFor(closeAction) + "/" + keyFor(helpAction), "close"},
		}
	}
	if s.filterOpen {
		return []KeyHint{{"enter", "keep"}, {"esc", "clear"}}
	}
	if s.selectedIndex(d) >= 0 {
		navigation, movement := KeyHint{keyFor(openAction), "open"}, "select"
		if s.focus == detailPane {
			navigation, movement = KeyHint{keyFor(closeAction), "back"}, "scroll"
		}
		hints = append(hints, KeyHint{keyFor(downAction) + "/" + keyFor(upAction), movement}, KeyHint{keyFor(nextPaneAction), "pane"}, navigation)
	}
	hints = append(hints, KeyHint{keyFor(helpAction), "help"})
	if filterEnabled {
		hints = append(hints, KeyHint{keyFor(filterAction), "filter"})
		if s.filterText != "" && s.focus == listPane {
			hints = append(hints, KeyHint{keyFor(closeAction), "clear"})
		}
	}
[[[if not .Hosted]]]	hints = append(hints, KeyHint{keyFor(quitAction), "quit"})
[[[end]]]	return hints
}

func footer(s state, d data, p layout) string {
	hints := keyHints(s, d)
	if s.helpOpen || s.filterOpen || s.selectedIndex(d) < 0 {
		return hintText(hints)
	}
	// Keep the way into or out of a pane visible at the minimum width. Extra
	// hints are optional, but an incomplete clipped key description is not.
	compact := hintText(hints[2:])
	pane := hintText(hints[1:])
	full := hintText(hints[:1]) + "  " + pane
	for _, hint := range []string{full, pane, compact} {
		if ansi.StringWidth(hint) <= p.width {
			return hint
		}
	}
	return compact
}

func (b browser) render(p layout, t theme) string {
	if p.width <= 0 || p.height <= 0 {
		return ""
	}
	return b.tree(p, t).Render(p.width, p.height)
}
