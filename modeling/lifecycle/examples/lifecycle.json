{
  "formatVersion": "lifecycle-json/v1",
  "profileVersion": "lifecycle/v1",
  "id": "TaskLifecycleExample",
  "initial": "Draft",
  "states": [
    {
      "id": "Draft",
      "label": "Draft",
      "terminal": false
    },
    {
      "id": "Ready",
      "label": "Ready",
      "terminal": false
    },
    {
      "id": "InProgress",
      "label": "In progress",
      "terminal": false
    },
    {
      "id": "InReview",
      "label": "In review",
      "terminal": false
    },
    {
      "id": "Done",
      "label": "Done",
      "terminal": true
    }
  ],
  "requirements": [
    {
      "id": "R_revision",
      "text": "Command matches the current revision."
    },
    {
      "id": "R_outcome",
      "text": "An outcome is nonblank."
    },
    {
      "id": "R_acceptance",
      "text": "Acceptance criteria are supplied."
    },
    {
      "id": "R_actor",
      "text": "The named starting actor is nonblank."
    },
    {
      "id": "R_ownerCompatible",
      "text": "Start assigns only absent ownership or matches the existing owner."
    },
    {
      "id": "R_owner",
      "text": "An owner is present."
    },
    {
      "id": "R_ownerActor",
      "text": "The owner requests review."
    },
    {
      "id": "R_reviewer",
      "text": "The reviewer is nonblank."
    },
    {
      "id": "R_reviewTask",
      "text": "Review refers to this task."
    },
    {
      "id": "R_reviewRevision",
      "text": "Review refers to the current revision."
    },
    {
      "id": "R_reviewModel",
      "text": "Review refers to the accepted model."
    },
    {
      "id": "R_reviewContent",
      "text": "Review refers to current task content."
    },
    {
      "id": "R_reviewActor",
      "text": "The acting reviewer matches the review."
    },
    {
      "id": "R_independent",
      "text": "The reviewer differs from the owner."
    },
    {
      "id": "R_approved",
      "text": "Approval is explicit."
    },
    {
      "id": "R_changesRequested",
      "text": "Changes are explicitly requested."
    }
  ],
  "guards": [
    {
      "id": "G_revision",
      "requirement": "R_revision",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "task.revision"
          },
          {
            "ref": "command.expectedRevision"
          }
        ]
      }
    },
    {
      "id": "G_outcome",
      "requirement": "R_outcome",
      "expr": {
        "op": "nonempty",
        "args": [
          {
            "ref": "task.outcome"
          }
        ]
      }
    },
    {
      "id": "G_acceptance",
      "requirement": "R_acceptance",
      "expr": {
        "op": "nonempty",
        "args": [
          {
            "ref": "task.acceptance"
          }
        ]
      }
    },
    {
      "id": "G_actor",
      "requirement": "R_actor",
      "expr": {
        "op": "nonempty",
        "args": [
          {
            "ref": "command.actor"
          }
        ]
      }
    },
    {
      "id": "G_ownerCompatible",
      "requirement": "R_ownerCompatible",
      "expr": {
        "op": "any",
        "args": [
          {
            "op": "absent",
            "args": [
              {
                "ref": "task.owner"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "ref": "task.owner"
              },
              {
                "ref": "command.actor"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "G_owner",
      "requirement": "R_owner",
      "expr": {
        "op": "nonempty",
        "args": [
          {
            "ref": "task.owner"
          }
        ]
      }
    },
    {
      "id": "G_ownerActor",
      "requirement": "R_ownerActor",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "task.owner"
          },
          {
            "ref": "command.actor"
          }
        ]
      }
    },
    {
      "id": "G_reviewer",
      "requirement": "R_reviewer",
      "expr": {
        "op": "nonempty",
        "args": [
          {
            "ref": "review.reviewer"
          }
        ]
      }
    },
    {
      "id": "G_reviewTask",
      "requirement": "R_reviewTask",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.taskId"
          },
          {
            "ref": "task.id"
          }
        ]
      }
    },
    {
      "id": "G_reviewRevision",
      "requirement": "R_reviewRevision",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.taskRevision"
          },
          {
            "ref": "task.revision"
          }
        ]
      }
    },
    {
      "id": "G_reviewModel",
      "requirement": "R_reviewModel",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.modelDigest"
          },
          {
            "ref": "model.digest"
          }
        ]
      }
    },
    {
      "id": "G_reviewContent",
      "requirement": "R_reviewContent",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.taskDigest"
          },
          {
            "ref": "task.digest"
          }
        ]
      }
    },
    {
      "id": "G_reviewActor",
      "requirement": "R_reviewActor",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.reviewer"
          },
          {
            "ref": "command.actor"
          }
        ]
      }
    },
    {
      "id": "G_independent",
      "requirement": "R_independent",
      "expr": {
        "op": "ne",
        "args": [
          {
            "ref": "review.reviewer"
          },
          {
            "ref": "task.owner"
          }
        ]
      }
    },
    {
      "id": "G_approved",
      "requirement": "R_approved",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.decision"
          },
          {
            "string": "approved"
          }
        ]
      }
    },
    {
      "id": "G_changesRequested",
      "requirement": "R_changesRequested",
      "expr": {
        "op": "eq",
        "args": [
          {
            "ref": "review.decision"
          },
          {
            "string": "changesRequested"
          }
        ]
      }
    }
  ],
  "transitions": [
    {
      "id": "T_prepare",
      "from": "Draft",
      "trigger": "prepare",
      "to": "Ready",
      "guards": [
        "G_revision",
        "G_outcome",
        "G_acceptance"
      ],
      "effects": [
        {
          "op": "set_state"
        },
        {
          "op": "increment_revision"
        }
      ]
    },
    {
      "id": "T_start",
      "from": "Ready",
      "trigger": "start",
      "to": "InProgress",
      "guards": [
        "G_revision",
        "G_outcome",
        "G_acceptance",
        "G_actor",
        "G_ownerCompatible"
      ],
      "effects": [
        {
          "op": "assign_owner_if_absent"
        },
        {
          "op": "set_state"
        },
        {
          "op": "increment_revision"
        }
      ]
    },
    {
      "id": "T_requestReview",
      "from": "InProgress",
      "trigger": "requestReview",
      "to": "InReview",
      "guards": [
        "G_revision",
        "G_outcome",
        "G_acceptance",
        "G_owner",
        "G_ownerActor"
      ],
      "effects": [
        {
          "op": "set_state"
        },
        {
          "op": "increment_revision"
        }
      ]
    },
    {
      "id": "T_approve",
      "from": "InReview",
      "trigger": "approve",
      "to": "Done",
      "guards": [
        "G_revision",
        "G_outcome",
        "G_acceptance",
        "G_owner",
        "G_reviewer",
        "G_reviewTask",
        "G_reviewRevision",
        "G_reviewModel",
        "G_reviewContent",
        "G_reviewActor",
        "G_independent",
        "G_approved"
      ],
      "effects": [
        {
          "op": "set_state"
        },
        {
          "op": "increment_revision"
        }
      ]
    },
    {
      "id": "T_requestChanges",
      "from": "InReview",
      "trigger": "requestChanges",
      "to": "InProgress",
      "guards": [
        "G_revision",
        "G_outcome",
        "G_acceptance",
        "G_owner",
        "G_reviewer",
        "G_reviewTask",
        "G_reviewRevision",
        "G_reviewModel",
        "G_reviewContent",
        "G_reviewActor",
        "G_independent",
        "G_changesRequested"
      ],
      "effects": [
        {
          "op": "set_state"
        },
        {
          "op": "increment_revision"
        }
      ]
    }
  ]
}
