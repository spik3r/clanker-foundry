  "requirements": [
    {
      "id": "R_ownerAbsent",
      "text": "Owner absence differs from present empty ownership."
    },
    {
      "id": "R_ownerEmpty",
      "text": "An empty but present owner compares equal to the empty string."
    },
    {
      "id": "R_ownerDifferent",
      "text": "Only a present nonempty raw owner differs from empty."
    },
    {
      "id": "R_ownerText",
      "text": "Owner nonempty trims Unicode whitespace."
    },
    {
      "id": "R_ownerReviewerEqual",
      "text": "Both optional strings must be present and equal."
    },
    {
      "id": "R_ownerReviewerDifferent",
      "text": "Both optional strings must be present and different."
    },
    {
      "id": "R_criteria",
      "text": "An acceptance list must contain at least one item."
    },
    {
      "id": "R_allSixteen",
      "text": "Every one of sixteen exclusions must hold."
    },
    {
      "id": "R_anySixteen",
      "text": "Any one of sixteen alternatives suffices."
    },
    {
      "id": "R_nested",
      "text": "An absent owner or matching actor, together with a nonempty list, permits transition."
    }
