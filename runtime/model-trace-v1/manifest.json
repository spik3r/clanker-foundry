  "requirements": [
    {
      "id": "TR-ADMIT",
      "command": "ADMIT",
      "statement": "A valid invented read-only admission produces a PENDING record without effects.",
      "anchor": "state: 'PENDING', stage_index: 0",
      "schemaPointer": "#/$defs/Command/oneOf/0",
      "caseIds": [
        "admit_read_only_pending"
      ],
      "existingTest": "admission is typed, immutable and restricted to supported read-only workflows",
      "expectedCode": null,
      "existingTestPath": "runtime/test/state.test.mjs"
    },
    {
      "id": "TR-DEPENDENCY",
      "command": "ASSIGN",
      "statement": "Assignment refuses when the dependency assertion is not true.",
      "anchor": "requireGuard(context.dependencies_satisfied === true, 'DEPENDENCIES_NOT_SATISFIED');",
      "schemaPointer": "#/$defs/Command/oneOf/1",
      "caseIds": [
        "assign_dependencies_missing",
        "assign_dependencies_false"
      ],
      "existingTest": "readiness, trusted identity, revisions and fencing reject stale workers",
      "expectedCode": "DEPENDENCIES_NOT_SATISFIED",
      "existingTestPath": "runtime/test/state.test.mjs"
    },
    {
      "id": "TR-RESOURCE",
      "command": "ASSIGN",
      "statement": "After the dependency guard passes, assignment refuses when the resource assertion is not true.",
      "anchor": "requireGuard(context.resources_available === true, 'RESOURCE_CONFLICT');",
      "schemaPointer": "#/$defs/Command/oneOf/1",
      "caseIds": [
        "assign_resources_missing",
        "assign_resources_false"
      ],
      "existingTest": "assignment intents remain hypothetical and stale revisions/uncertain prerequisites refuse",
      "expectedCode": "RESOURCE_CONFLICT",
      "existingTestPath": "runtime/test/consumer-shadow-v1.test.mjs"
    }
  ],
