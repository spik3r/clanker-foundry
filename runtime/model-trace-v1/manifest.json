  "requirements": [
    {
      "id": "TR-ADMIT",
      "command": "ADMIT",
      "statement": "A valid invented read-only admission produces a PENDING record without effects.",
      "anchor": "state: 'PENDING', stage_index: 0",
      "schemaPointer": "#/$defs/Command/oneOf/0",
      "caseIds": [
        "admit_read_only_pending"
      ],
      "existingTest": "admission is typed, immutable and restricted to supported read-only workflows",
      "expectedCode": null,
      "existingTestPath": "runtime/test/state.test.mjs"
    },
    {
      "id": "TR-DEPENDENCY",
      "command": "ASSIGN",
      "statement": "Assignment refuses when the dependency assertion is not true.",
      "anchor": "requireGuard(context.dependencies_satisfied === true, 'DEPENDENCIES_NOT_SATISFIED');",
      "schemaPointer": "#/$defs/Command/oneOf/1",
      "caseIds": [
        "assign_dependencies_missing",
        "assign_dependencies_false"
      ],
      "existingTest": "readiness, trusted identity, revisions and fencing reject stale workers",
      "expectedCode": "DEPENDENCIES_NOT_SATISFIED",
      "existingTestPath": "runtime/test/state.test.mjs"
    },
    {
      "id": "TR-RESOURCE",
      "command": "ASSIGN",
      "statement": "After the dependency guard passes, assignment refuses when the resource assertion is not true.",
      "anchor": "requireGuard(context.resources_available === true, 'RESOURCE_CONFLICT');",
      "schemaPointer": "#/$defs/Command/oneOf/1",
      "caseIds": [
        "assign_resources_missing",
        "assign_resources_false"
      ],
      "existingTest": "assignment intents remain hypothetical and stale revisions/uncertain prerequisites refuse",
      "expectedCode": "RESOURCE_CONFLICT",
      "existingTestPath": "runtime/test/consumer-shadow-v1.test.mjs"
    },
    {
      "id": "TR-ASSIGN-SUCCESS",
      "command": "ASSIGN",
      "statement": "A valid invented read-only assignment records the supplied worker attempt, advances the fence and returns a LAUNCH_ATTEMPT intent.",
      "anchor": "execution.state = 'ASSIGNED';",
      "schemaPointer": "#/$defs/Command/oneOf/1",
      "caseIds": [
        "assign_success"
      ],
      "existingTest": "frozen dispatch observations compare full execution, event, effects and unchanged inputs",
      "expectedCode": null,
      "existingTestPath": "runtime/test/model-trace-v1.test.mjs"
    },
    {
      "id": "TR-ACK-SUCCESS",
      "command": "ACKNOWLEDGE",
      "statement": "The matching worker acknowledges its live attempt before the lease deadline without returning an effect.",
      "anchor": "execution.state = 'EXECUTING';",
      "schemaPointer": "#/$defs/Command/oneOf/2",
      "caseIds": [
        "ack_success"
      ],
      "existingTest": "frozen dispatch observations compare full execution, event, effects and unchanged inputs",
      "expectedCode": null,
      "existingTestPath": "runtime/test/model-trace-v1.test.mjs"
    },
    {
      "id": "TR-SUBMIT-SUCCESS",
      "command": "SUBMIT",
      "statement": "The matching live worker submits a consistent successful artifact manifest; validation starts and a RUN_CHECKS intent names the stage checks.",
      "anchor": "execution.state = 'VALIDATING';",
      "schemaPointer": "#/$defs/Command/oneOf/3",
      "caseIds": [
        "submit_success"
      ],
      "existingTest": "frozen dispatch observations compare full execution, event, effects and unchanged inputs",
      "expectedCode": null,
      "existingTestPath": "runtime/test/model-trace-v1.test.mjs"
    },
    {
      "id": "TR-ACK-WRONG-WORKER",
      "command": "ACKNOWLEDGE",
      "statement": "Acknowledgement by a different worker refuses.",
      "anchor": "authorized(context.role === 'worker' && context.actor_id === execution.attempt.worker_id);",
      "schemaPointer": "#/$defs/Command/oneOf/2",
      "caseIds": [
        "ack_wrong_worker"
      ],
      "existingTest": "frozen dispatch observations compare full execution, event, effects and unchanged inputs",
      "expectedCode": "UNAUTHORIZED",
      "existingTestPath": "runtime/test/model-trace-v1.test.mjs"
    },
    {
      "id": "TR-ACK-STALE-FENCE",
      "command": "ACKNOWLEDGE",
      "statement": "Acknowledgement with a stale fence refuses.",
      "anchor": "requireGuard(execution.attempt !== null && input.attempt_id === execution.attempt.attempt_id && input.fencing_token === execution.attempt.fencing_token, 'STALE_ATTEMPT');",
      "schemaPointer": "#/$defs/Command/oneOf/2",
      "caseIds": [
        "ack_stale_fence"
      ],
      "existingTest": "frozen dispatch observations compare full execution, event, effects and unchanged inputs",
      "expectedCode": "STALE_ATTEMPT",
      "existingTestPath": "runtime/test/model-trace-v1.test.mjs"
    },
    {
      "id": "TR-ACK-EXPIRED-LEASE",
      "command": "ACKNOWLEDGE",
