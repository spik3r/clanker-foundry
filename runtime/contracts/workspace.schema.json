{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clanker-foundry.invalid/contracts/workspace/v1.schema.json",
  "title": "Isolated workspace plan contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "spec_digest", "attempt_id", "repository_revision", "write_scope", "operations"],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "spec_digest": { "$ref": "#/$defs/digest" },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "repository_revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "write_scope": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$" },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "action", "before_digest", "content"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "action": { "const": "write" },
            "before_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
            "content": { "type": "string", "maxLength": 1048576 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "action", "before_digest", "content"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "action": { "const": "delete" },
            "before_digest": { "$ref": "#/$defs/digest" },
            "content": { "type": "null" }
          }
        }
      ]
    }
  }
}
