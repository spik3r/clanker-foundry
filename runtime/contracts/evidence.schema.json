{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clanker-foundry.local/contracts/evidence.schema.json",
  "$defs": {
    "EvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "execution_id", "spec_digest", "task_id", "repository", "source_repository", "source_revision", "source_path", "source_blob", "claim_heading", "claim_digest", "run_id", "start_event_id", "start_event_digest", "head_event_id", "head_event_digest", "files", "code_root", "source_root"],
      "properties": {
        "schema_version": {"const": 1},
        "execution_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "spec_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "task_id": {"type": "string", "minLength": 3, "maxLength": 80},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "source_revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "source_path": {"type": "string", "pattern": "^tasks/[^\\\\\\u0000]+\\.md$", "maxLength": 1024},
        "source_blob": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "claim_heading": {"type": "string", "minLength": 1, "maxLength": 512},
        "claim_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "run_id": {"$ref": "#/$defs/UUID"},
        "start_event_id": {"$ref": "#/$defs/UUID"},
        "start_event_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "head_event_id": {"$ref": "#/$defs/UUID"},
        "head_event_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "files": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "code_root": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "source_root": {"type": "string", "pattern": "^/", "maxLength": 4096}
      }
    },
    "UUID": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[0-9a-f]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"}
  }
}
