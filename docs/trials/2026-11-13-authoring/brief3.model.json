        {"id": "Passed", "label": "Passed", "type": "number"},
        {"id": "Failed", "label": "Failed", "type": "number"},
        {"id": "MedianMinutes", "label": "Median build time (min)", "type": "number"}
      ],
      "rows": [
        ["Mon", 80, 5, 11.5],
        ["Tue", 78, 7, 12],
        ["Wed", 85, 3, 10.75],
        ["Thu", 70, 9, 14],
        ["Fri", 73, 2, 11]
      ]
    }
  ],
  "widgets": [
